# ─────────────────────────────────────────────────────────────
#  Carla Tamassint Transport — environment variables
#  Copy to .env.local (development) or set in your hosting dashboard.
#  Never commit real credentials.
# ─────────────────────────────────────────────────────────────

# Public origin, used for canonical URLs, sitemap and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.example.ma

# Allow search engines to index the site. Keep "false" on staging.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Show demonstration routes/agencies/programmes in a production build (staging preview only).
# Pages are forced to noindex when enabled. Never enable on the public site.
NEXT_PUBLIC_SHOW_DEMO_CONTENT=false

# ── Booking (Markoub.ma) ─────────────────────────────────────
# Verified, embeddable Markoub.ma booking/search URL. Leave empty to use the
# fallback panel with an external link (see src/config/booking.ts before setting).
NEXT_PUBLIC_MARKOUB_EMBED_URL=
# Verified deep-link template to a route search. Placeholders: {from} {to} {date}
NEXT_PUBLIC_MARKOUB_SEARCH_URL_TEMPLATE=

# ── Contact & training forms (server-side only) ──────────────
# Option 1 — Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Option 2 — JSON webhook (n8n, Make, Zapier, Formspree, CRM…)
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# ── Assistant Carla (chatbot) ────────────────────────────────
# "local" = deterministic FAQ assistant in the browser (default)
# "remote" = calls /api/chat (uses AI only if configured below, otherwise the FAQ engine)
NEXT_PUBLIC_CHAT_MODE=local
# Optional server-side AI (Anthropic). Key is never sent to the browser.
CHAT_AI_ENABLED=false
ANTHROPIC_API_KEY=
CHAT_AI_MODEL=claude-opus-5-5

# ── Analytics (disabled until set; loaded only after visitor consent) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Google Search Console HTML-tag verification token ────────
GOOGLE_SITE_VERIFICATION=
