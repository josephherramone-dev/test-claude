{
  "name": "Free video generator (MoneyPrinterTurbo)",
  "nodes": [
    {"parameters": {}, "name": "Start", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1, "position": [0, 0], "id": "a1"},
    {"parameters": {"assignments": {"assignments": [
        {"id": "s1", "name": "subject", "value": "3 surprising facts about octopuses", "type": "string"},
        {"id": "s2", "name": "api", "value": "http://PUT-MPT-API-CONTAINER-NAME:8080", "type": "string"}
      ]}, "options": {}},
     "name": "Video idea", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [220, 0], "id": "a2"},
    {"parameters": {"method": "POST", "url": "={{ $json.api }}/api/v1/videos", "sendBody": true, "specifyBody": "json",
      "jsonBody": "={{ JSON.stringify({ video_subject: $json.subject, video_aspect: '9:16', video_source: 'pexels', video_count: 1, video_clip_duration: 3, voice_name: 'en-US-JennyNeural-Female', subtitle_enabled: true, bgm_type: 'random', paragraph_number: 1 }) }}",
      "options": {}},
     "name": "Start video", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [440, 0], "id": "a3"},
    {"parameters": {"amount": 60, "unit": "seconds"}, "name": "Wait 1 min", "type": "n8n-nodes-base.wait", "typeVersion": 1.1, "position": [660, 0], "id": "a4", "webhookId": "b7f1c2d4-0000-4000-8000-000000000001"},
    {"parameters": {"url": "={{ $('Video idea').item.json.api }}/api/v1/tasks/{{ $('Start video').item.json.data.task_id }}", "options": {}},
     "name": "Check status", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [880, 0], "id": "a5"},
    {"parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "loose"}, "combinator": "and",
        "conditions": [{"id": "c1", "leftValue": "={{ $json.data.state }}", "rightValue": 1, "operator": {"type": "number", "operation": "equals"}}]}, "looseTypeValidation": true, "options": {}},
     "name": "Finished?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1100, 0], "id": "a6"},
    {"parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "loose"}, "combinator": "and",
        "conditions": [{"id": "c2", "leftValue": "={{ $json.data.state }}", "rightValue": -1, "operator": {"type": "number", "operation": "equals"}}]}, "looseTypeValidation": true, "options": {}},
     "name": "Failed?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [1320, 160], "id": "a7"},
    {"parameters": {"errorMessage": "Video generation failed - look at the mpt-api logs in Coolify"}, "name": "Stop: failed", "type": "n8n-nodes-base.stopAndError", "typeVersion": 1, "position": [1540, 100], "id": "a8"},
    {"parameters": {"url": "={{ $json.data.videos[0] }}", "options": {"response": {"response": {"responseFormat": "file"}}}},
     "name": "Download video", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1320, -120], "id": "a9"}
  ],
  "connections": {
    "Start": {"main": [[{"node": "Video idea", "type": "main", "index": 0}]]},
    "Video idea": {"main": [[{"node": "Start video", "type": "main", "index": 0}]]},
    "Start video": {"main": [[{"node": "Wait 1 min", "type": "main", "index": 0}]]},
    "Wait 1 min": {"main": [[{"node": "Check status", "type": "main", "index": 0}]]},
    "Check status": {"main": [[{"node": "Finished?", "type": "main", "index": 0}]]},
    "Finished?": {"main": [[{"node": "Download video", "type": "main", "index": 0}], [{"node": "Failed?", "type": "main", "index": 0}]]},
    "Failed?": {"main": [[{"node": "Stop: failed", "type": "main", "index": 0}], [{"node": "Wait 1 min", "type": "main", "index": 0}]]}
  },
  "settings": {}
}
